+// Maps commit count to a mix weight. n=1 → 0.10, n=2 → 0.20, n=4 → 0.30,
+// n=8 → 0.40, then clamped to [cap]. Keep in sync with Kotlin UserHistoryWeight.
+float userHistoryWeightForCount(int32_t n, float cap) {
+    if (n <= 0) {
+        return 0.F;
+    }
+    if (cap < 0.05F) {
+        cap = 0.05F;
+    } else if (cap > 0.95F) {
+        cap = 0.95F;
+    }
+    const float grown = 0.1F * (1.F + std::log2(static_cast<float>(n)));
+    return grown < cap ? grown : cap;
+}
